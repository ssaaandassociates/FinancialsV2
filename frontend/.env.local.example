# Copy this file to .env.local and fill in real values.
# (.env.local is gitignored — never commit real secrets.)

# Where the FastAPI backend lives.
#   local dev: http://localhost:8000
#   prod:      the Railway internal URL of the backend service
BACKEND_URL=http://localhost:8000

# Supabase project — both values are PUBLIC (safe to expose in the browser).
# Get them from: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
